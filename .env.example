# No model credentials belong here. The demo asks the local model gateway,
# which replays committed fixtures by default. See model-gateway.toml.
MODEL_GATEWAY_URL=http://127.0.0.1:18157/ask

# Only the Cloud node needs this: the bootstrap token from Expanso Cloud.
# Copy to .env (git-ignored) and fill it in before the one-time enroll step.
EXPANSO_EDGE_BOOTSTRAP_TOKEN=
